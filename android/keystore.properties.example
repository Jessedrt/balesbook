# Copy to android/keystore.properties (gitignored) and fill in.
#
# This is written for Google Play App Signing: Google holds the app signing key,
# and this is only your UPLOAD key — losing it is recoverable, which is the
# whole point. Generate it with:
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore balebook-upload.keystore -alias balebook-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Never commit the .keystore or this file with real values.

storeFile=balebook-upload.keystore
storePassword=CHANGE_ME
keyAlias=balebook-upload
keyPassword=CHANGE_ME
