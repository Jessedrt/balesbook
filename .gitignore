node_modules/
.project_id
.github_repo
.env
.env.*
!.env.example

# Build output — regenerated by `npm run build` / `vite build` on every deploy.
# It was committed once (166 files, 7.2 MB) which made every build a wall of
# churn in git and risked blowing past artifact limits.
.vercel/
dist/
.output/

# Android / Capacitor build output. The generated project IS committed (that is
# the normal Capacitor layout) but its build products are not.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
# Generated by `npm run android:sync` from BALEBOOK_SERVER_URL — environment
# specific, so never committed. A fresh clone runs the sync script first.
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/public/
# Generated by scripts/write-capacitor-config.mjs (contains BALEBOOK_SERVER_URL).
capacitor.config.json
# Release signing material must never be committed — see ANDROID.md.
android/keystore.properties
android/*.keystore
android/*.jks
*.keystore
*.jks

# Generated app icons/splash are reproducible from assets/ via
# `npm run assets:android`, but kept in git so an Android build works without
# running the generator first.

# OS / editor noise
.DS_Store
*.log
